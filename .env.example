# Local demo needs no external service. Never commit your actual .env.
ADMIN_TOKEN=
# Production / multiple replicas: set a persistent random secret (>=32 chars).
APP_SECRET=
# Leave empty for SQLite local demo; Docker sets PostgreSQL automatically.
DATABASE_URL=
# Optional model integration; leave both empty to use offline mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
