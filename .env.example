# Local demo needs no external service. Never commit your actual .env.
ADMIN_TOKEN=
# Production / multiple replicas: set a persistent random secret (>=32 chars).
APP_SECRET=
# Leave empty for SQLite local demo; Docker sets PostgreSQL automatically.
DATABASE_URL=
# Bailian / Qwen: leave API key empty for offline knowledge retrieval.
# Copy the Beijing workspace Base URL from your Bailian console.
# Enable Free Tier Only for the chosen model in Bailian before adding the key.
LLM_API_KEY=
LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 学校 HiAgent 智能体 API：配置后优先使用学校服务；密钥仅放在后端。
HIAGENT_BASE_URL=https://agent.suibe.edu.cn/api/proxy/api/v1
HIAGENT_API_KEY=
